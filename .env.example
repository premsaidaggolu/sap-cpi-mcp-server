# Copy this file to `.env` and fill in the values from your SAP CPI service key.
# The service key is created on the "Process Integration Runtime" (it-rt) service
# instance with plan "api" in your BTP subaccount.

# Base URL of the CPI OData API (note the trailing /api/v1, no trailing slash after it):
CPI_BASE_URL=https://your-tenant.it-cpiXXX.cfapps.eu10.hana.ondemand.com/api/v1

# OAuth2 token endpoint (from the "tokenurl" field of the service key, ending in /oauth/token):
CPI_TOKEN_URL=https://your-subdomain.authentication.eu10.hana.ondemand.com/oauth/token

# OAuth2 client credentials (from the service key):
CPI_CLIENT_ID=your-client-id
CPI_CLIENT_SECRET=your-client-secret

# Transport: "stdio" for local Claude Desktop/Code, "http" for server deployment.
MCP_TRANSPORT=stdio

# Write safety: read tools always work. Set to "true" to enable create/update/delete/deploy
# tools. Destructive tools additionally require a confirm=true argument at call time.
ALLOW_WRITE=false

# Only used when MCP_TRANSPORT=http. If set, callers must send Authorization: Bearer <token>.
# MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

# Only used when MCP_TRANSPORT=http and running locally (CF injects its own PORT).
# PORT=3000
